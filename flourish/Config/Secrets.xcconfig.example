// Secrets.xcconfig.example
// Copy this file to Secrets.xcconfig and fill in the real values.
// Secrets.xcconfig is gitignored — never commit it.

// Cloudflare Worker URL (no https://, no trailing slash)
flourish_PROXY_URL   = flourish-proxy.<your-subdomain>.workers.dev

// Supabase — from Project Settings → API in the Supabase dashboard
// NOTE: omit https:// — xcconfig treats // as a comment. The app prepends https:// at runtime.
SUPABASE_URL       = <your-project-ref>.supabase.co
SUPABASE_ANON_KEY  = <your-anon-public-key>
